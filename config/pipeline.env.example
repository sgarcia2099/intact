PWIZ_IMAGE="proteowizard/pwiz-skyline-i-agree-to-the-vendor-licenses:latest"
PWIZ_DOCKER_SECURITY_OPT="seccomp=unconfined"
OPENMS_IMAGE="ghcr.io/openms/openms-executables:latest"

# This path is resolved relative to ROOT_DIR in the shell wrappers.
FLASHDECONV_INI="${ROOT_DIR}/config/flashdeconv.ini"
FLASHDECONV_THREADS="4"

MSCONVERT_PEAK_PICKING="vendor"
MSCONVERT_BINARY_ENCODING="32"
MSCONVERT_COMPRESSION="zlib"
MSCONVERT_EXTRA_FILTERS=""

FILTER_PPM="10"
FILTER_RT_MINUTES="0.5"
FILTER_MIN_INTENSITY="0"
# FLASHDeconv QScore threshold applied during the R filter stage.
# 0 disables this filter. FLASHDeconv recommends QScore > 0 as a minimum;
# values >= 0.5 give higher-confidence features.
FILTER_MIN_QSCORE="0.5"

KEEP_INTERMEDIATE="1"
CONTINUE_ON_ERROR="1"